/* FormCheck Theme Stylesheet - Auto-generated from services/theme.py */
/* Clear solid 4-sided outlines with sharp 6px corners */

QWidget {
    background-color: #0a0f1d;
    color: #f8fafc;
    font-family: 'Rajdhani', 'Bahnschrift', 'Segoe UI', sans-serif;
    font-size: 13px;
    letter-spacing: 0.5px;
}

/* ==========================================================================
   Group Boxes / Containers (Continuous 4-sided Outlines)
   ========================================================================== */
QGroupBox {
    background-color: #0f172a;
    border: 1px solid #415e87;
    border-radius: 6px;
    margin-top: 24px;
    padding: 16px 12px 12px 12px;
    font-family: 'Orbitron', 'Bahnschrift', 'Agency FB', sans-serif;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #38bdf8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    left: 12px;
    top: 2px;
    background-color: #1e293b;
    border: 1px solid #415e87;
    border-radius: 4px;
    color: #38bdf8;
    font-family: 'Orbitron', 'Bahnschrift', 'Agency FB', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

/* ==========================================================================
   Combo Boxes (Continuous 4-sided Outlines)
   ========================================================================== */
QComboBox {
    background-color: #1e293b;
    border: 1px solid #415e87;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 28px;
    color: #f8fafc;
    font-family: 'Rajdhani', 'Bahnschrift', 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: 0.8px;
}

QComboBox:hover {
    border: 1px solid #38bdf8;
    background-color: #0f172a;
}

QComboBox:focus {
    border: 1.5px solid #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #0f172a;
    border: 1px solid #415e87;
    border-radius: 4px;
    selection-background-color: #38bdf8;
    selection-color: #ffffff;
    color: #f8fafc;
    padding: 4px;
    outline: none;
    font-family: 'Rajdhani', 'Bahnschrift', 'Segoe UI', sans-serif;
}

/* ==========================================================================
   Buttons (Solid Clean Outlines)
   ========================================================================== */
QPushButton {
    background-color: #1e293b;
    border: 1px solid #415e87;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 28px;
    color: #f8fafc;
    font-family: 'Orbitron', 'Bahnschrift', 'Agency FB', sans-serif;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QPushButton:hover {
    background-color: #415e87;
    border: 1px solid #38bdf8;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0f172a;
    border: 1px solid #415e87;
}

QPushButton:disabled {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    color: #94a3b8;
}

/* Start Button: Accent Action Outline */
QPushButton#btn_start {
    background-color: #059669;
    border: 1px solid #10b981;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    border-radius: 6px;
    min-height: 28px;
}

QPushButton#btn_start:hover {
    background-color: #10b981;
    border: 1px solid #ffffff;
}

QPushButton#btn_start:pressed {
    background-color: #064e3b;
    border: 1px solid #059669;
}

/* Pause Button */
QPushButton#btn_pause {
    background-color: #d97706;
    border: 1px solid #fbbf24;
    color: #ffffff;
    font-weight: 600;
    border-radius: 6px;
}

QPushButton#btn_pause:hover {
    border: 1px solid #ffffff;
}

QPushButton#btn_pause:pressed {
    background-color: #78350f;
}

/* Stop Button */
QPushButton#btn_stop {
    background-color: #dc2626;
    border: 1px solid #ef4444;
    color: #ffffff;
    font-weight: 600;
    border-radius: 6px;
}

QPushButton#btn_stop:hover {
    border: 1px solid #ffffff;
}

QPushButton#btn_stop:pressed {
    background-color: #7f1d1d;
}

/* Reset Button */
QPushButton#btn_reset {
    background-color: #1e293b;
    border: 1px solid #415e87;
    color: #94a3b8;
    border-radius: 6px;
}

QPushButton#btn_reset:hover {
    color: #f8fafc;
    border: 1px solid #94a3b8;
}

/* Primary Dialog Button */
QPushButton#btn_primary {
    background-color: #059669;
    border: 1px solid #10b981;
    color: #ffffff;
    font-family: 'Orbitron', 'Bahnschrift', 'Agency FB', sans-serif;
    font-size: 14px;
    letter-spacing: 1.5px;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 800;
    min-height: 24px;
}

QPushButton#btn_primary:hover {
    background-color: #10b981;
    border: 1px solid #ffffff;
}

QPushButton#btn_primary:pressed {
    background-color: #064e3b;
}

QPushButton#btn_link {
    background-color: transparent;
    border: none;
    color: #38bdf8;
    text-decoration: underline;
    padding: 6px;
    font-family: 'Orbitron', 'Rajdhani', 'Bahnschrift', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.8px;
}

QPushButton#btn_link:hover {
    color: #60a5fa;
}

/* ==========================================================================
   Progress Bar
   ========================================================================== */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #415e87;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #10b981;
    border-radius: 4px;
}

/* ==========================================================================
   Status Bar
   ========================================================================== */
QStatusBar {
    background-color: #0f172a;
    color: #94a3b8;
    border-top: 1px solid #415e87;
    padding: 4px;
    font-family: 'Orbitron', 'Rajdhani', 'Bahnschrift', sans-serif;
    font-size: 12px;
    letter-spacing: 0.8px;
}

/* ==========================================================================
   Text Inputs (Visible 4-Sided Outlines)
   ========================================================================== */
QLineEdit {
    background-color: #0f172a;
    border: 1px solid #415e87;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 28px;
    color: #f8fafc;
    font-family: 'Rajdhani', 'Bahnschrift', 'Segoe UI', sans-serif;
    font-size: 13px;
    letter-spacing: 0.5px;
    selection-background-color: #38bdf8;
}

QLineEdit:hover {
    border: 1px solid #38bdf8;
}

QLineEdit:focus {
    border: 1.5px solid #38bdf8;
    background-color: #0a0f1d;
}

QLineEdit:disabled {
    background-color: #1e293b;
    color: #94a3b8;
    border-color: #1e293b;
}

/* ==========================================================================
   Tabs (Clean Connected Outlines)
   ========================================================================== */
QTabWidget::pane {
    border: 1px solid #415e87;
    background-color: #0f172a;
    border-radius: 6px;
    top: 0px;
}

QTabBar::tab {
    background-color: #0a0f1d;
    color: #94a3b8;
    border: 1px solid #415e87;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 20px;
    margin-right: 4px;
    font-family: 'Orbitron', 'Bahnschrift', 'Agency FB', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QTabBar::tab:selected {
    background-color: #0f172a;
    color: #38bdf8;
    border: 1px solid #415e87;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background-color: #1e293b;
    color: #f8fafc;
}

/* ==========================================================================
   Checkboxes
   ========================================================================== */
QCheckBox {
    color: #94a3b8;
    font-family: 'Rajdhani', 'Bahnschrift', 'Segoe UI', sans-serif;
    spacing: 8px;
}

QCheckBox:hover {
    color: #f8fafc;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #415e87;
    background-color: #0f172a;
}

QCheckBox::indicator:hover {
    border-color: #38bdf8;
}

QCheckBox::indicator:checked {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

/* ==========================================================================
   Dialogs & Tables
   ========================================================================== */
QDialog {
    background-color: #0a0f1d;
}

QTableWidget {
    background-color: #0f172a;
    border: 1px solid #415e87;
    border-radius: 6px;
    gridline-color: #1e293b;
    color: #f8fafc;
    font-family: 'Rajdhani', 'Bahnschrift', 'Segoe UI', sans-serif;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #94a3b8;
    padding: 6px;
    border: 1px solid #415e87;
    font-family: 'Orbitron', 'Bahnschrift', 'Agency FB', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

/* Notification Banners */
QLabel#error_banner {
    background-color: rgba(220, 38, 38, 0.15);
    border: 1px solid #ef4444;
    border-radius: 6px;
    color: #ef4444;
    padding: 10px 14px;
    font-weight: 600;
}

QLabel#success_banner {
    background-color: rgba(5, 150, 105, 0.15);
    border: 1px solid #10b981;
    border-radius: 6px;
    color: #10b981;
    padding: 10px 14px;
    font-weight: 600;
}

QScrollBar:vertical {
    background-color: #0a0f1d;
    width: 10px;
    margin: 2px 2px 2px 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #415e87;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #38bdf8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
